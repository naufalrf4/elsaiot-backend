# ────────────────────────────────────────────────────────────────
# Application Configuration
# ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
ENABLE_SWAGGER=true
CORS_ORIGIN=*

# ────────────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL)
# ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=elsaiot
POSTGRES_PASSWORD=password
POSTGRES_DB=elsaiot

# ────────────────────────────────────────────────────────────────
# MQTT Broker Configuration
# ────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=elsaiot-backend

# ────────────────────────────────────────────────────────────────
# JWT Authentication Settings
# ────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────────────
# Google OAuth (Optional)
# ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=isi_dari_console_google
GOOGLE_CLIENT_SECRET=isi_dari_console_google
GOOGLE_CALLBACK_URL=http://localhost:4444/v1/auth/google/callback

# ────────────────────────────────────────────────────────────────
# Mail Configuration
# ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password
MAIL_FROM_NAME=ElsaIoT
MAIL_FROM_EMAIL=no-reply@elsaiot.com

FRONTEND_RESET_PASSWORD_URL=http://localhost:3001/reset-password
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60

# ────────────────────────────────────────────────────────────────
# External Notification Services (Optional)
# ────────────────────────────────────────────────────────────────
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
SMS_API_KEY=
TELEGRAM_BOT_TOKEN=

# ────────────────────────────────────────────────────────────────
# Logging Configuration
# ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
